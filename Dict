function intelligentSplit(text,type){
  let t=text.replace(/\r\n/g,'\n').replace(/\r/g,'\n').replace(/\t/g,' ').trim();
  t=t.replace(/[|_~`]/g,'');let items=[];
  if(type==='words'){
    let lines=t.split('\n').map(l=>l.trim()).filter(l=>l);
    if(lines.length<=3&&t.length>15){let joined=lines.join(' ');let parts=joined.split(/[,，、;；\s]+/).map(s=>s.trim()).filter(s=>s);if(parts.length>lines.length)items=parts;else items=lines;}
    else items=lines;
    items=items.map(i=>i.replace(/^[\d]+[.、．)\]】:：]\s*/,'').replace(/^[①②③④⑤⑥⑦⑧⑨⑩]\s*/,'').replace(/^[-–—•·]\s*/,'').trim());
  }else if(type==='sentences'){
    let sentences=t.split(/(?<=[。！？!?；;])/);
    if(sentences.length<=1)sentences=t.split('\n').map(l=>l.trim()).filter(l=>l);
    items=sentences.map(s=>s.replace(/^[\d]+[.、．)\]】:：]\s*/,'').trim()).filter(s=>s);
  }else{
    let paras=t.split(/\n\s*\n/);if(paras.length<=1)paras=t.split('\n').map(l=>l.trim()).filter(l=>l);
    items=paras.map(p=>p.replace(/\n/g,' ').trim()).filter(p=>p);
  }
  return items.filter(i=>i.length>0);
}

async function syncTab(lang){
  const tabName=getTabName(lang);
  const url=getSheetUrl(lang);
  debugLog('['+lang+'] 請求：'+url);
  let res;
  try{
    res=await fetch(url);
  }catch(netErr){
    debugLog('['+lang+'] 網絡錯誤：'+netErr.message);
    throw new Error('網絡錯誤，無法連線');
  }
  debugLog('['+lang+'] HTTP 狀態：'+res.status);
  if(!res.ok){
    throw new Error('HTTP '+res.status+'（請檢查分頁名稱「'+tabName+'」同共用設定）');
  }
  const text=await res.text();
  debugLog('['+lang+'] 回應長度：'+text.length+' 字元');
  debugLog('['+lang+'] 回應預覽：'+text.substring(0,120).replace(/\n/g,'⏎'));
  const trimmed=text.trim();
  // Not shared properly -> Google returns HTML login/error page
  if(trimmed.startsWith('<')||/<html/i.test(trimmed)||trimmed.toLowerCase().includes('<!doctype')){
    throw new Error('收到 HTML 而唔係 CSV。請確認試算表已共用為「知道連結的任何人」都可檢視');
  }
  // gviz error payload
  if(/google\.visualization|Error|invalid/i.test(trimmed.split('\n')[0])&&trimmed.length<300){
    throw new Error('Google 返回錯誤，可能分頁「'+tabName+'」唔存在');
  }
  const sp=parseSheetCSV(text,lang);
  debugLog('['+lang+'] 成功解析項目數：'+sp.length);
  if(!sp.length){
    throw new Error('讀取唔到有效資料。請檢查分頁「'+tabName+'」格式（Project / Type / Details，用 ; 分隔）');
  }
  return mergeSheetProjects(sp);
}

function speakAndSchedule(text){
  speakToken++;const myToken=speakToken;
  const lang=getCurLang();
  if(playMode==='auto'||isReviewMode){
    setTimerStatus('🔊 朗讀中');
    const spoken=speakText(text,lang,()=>{
      if(myToken!==speakToken)return;
      setTimerStatus('⏳ 倒數中');
      startCountdown();
    });
    if(!spoken&&myToken===speakToken){setTimerStatus('⏳ 倒數中');startCountdown();}
  }else{speakText(text,lang);}
}

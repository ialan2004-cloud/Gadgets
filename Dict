    else dot.classList.add('upcoming');
    track.appendChild(dot);
  }
}
function renderCheckList(){
  document.getElementById('checkList').innerHTML=dictItems.map((item,i)=>{
    const t=(playMode==='manual'&&wordTimes[i]!==undefined)?'<span class="time-chip">⏱ '+formatTime(wordTimes[i])+'</span>':'';
    return '<div class="check-item" id="checkItem'+i+'"><div class="num">'+(i+1)+'</div><div class="answer">'+escapeHtml(item)+'</div>'+t+'<div class="check-btns"><button class="check-btn btn-correct" onclick="markResult('+i+',true)" id="correct'+i+'">✓</button><button class="check-btn btn-wrong" onclick="markResult('+i+',false)" id="wrong'+i+'">✗</button></div></div>';
  }).join('');
}
function markResult(i,ok){checkResults[i]=ok;const item=document.getElementById('checkItem'+i);item.classList.remove('correct','wrong');document.getElementById('correct'+i).classList.remove('active');document.getElementById('wrong'+i).classList.remove('active');if(ok){item.classList.add('correct');document.getElementById('correct'+i).classList.add('active');}else{item.classList.add('wrong');document.getElementById('wrong'+i).classList.add('active');}}
function finishChecking(){
  const total=dictItems.length,correct=checkResults.filter(r=>r===true).length;
  const unchecked=checkResults.filter(r=>r===null).length;
  if(unchecked>0&&!confirm('仲有 '+unchecked+' 題未校對，確定結束？'))return;
  const percent=Math.round((correct/total)*100);
  showPage('result');
  document.getElementById('resultScore').innerText=correct;
  document.getElementById('resultTotal').innerText=total;
  document.getElementById('resultPercent').innerText=percent+'%';
  let emoji='🌟',title='太厲害喇！';
  if(percent<50){emoji='💪';title='繼續努力！';}else if(percent<70){emoji='📖';title='唔錯呀！';}else if(percent<90){emoji='😊';title='好叻呀！';}
  document.getElementById('resultEmoji').innerText=emoji;
  document.getElementById('resultTitle').innerText=title;
  const isManual=(playMode==='manual'&&wordTimes.length>0);
  if(isManual){
    document.getElementById('timeStats').classList.remove('hidden');
    document.getElementById('statTotalTime').innerText=formatTime(totalDictationSeconds);
    const avg=Math.round(totalDictationSeconds/total);
    document.getElementById('statAvgTime').innerText=formatTime(avg);
    let maxT=0;wordTimes.forEach(t=>{if((t||0)>maxT)maxT=t;});
    document.getElementById('statSlowest').innerText=formatTime(maxT);
    let ph='';
    dictItems.forEach((w,i)=>{
      const t=wordTimes[i];const wrong=checkResults[i]!==true;
      ph+='<div style="display:flex;justify-content:space-between;align-items:center;padding:7px 0;border-bottom:1px solid var(--border);font-size:13px;"><span>'+(i+1)+'. '+escapeHtml(w)+(wrong?' <span style="color:var(--danger)">❌</span>':'')+'</span><span style="font-weight:700;color:'+((t||0)>30?'var(--danger)':(t||0)>15?'var(--warning)':'var(--text-light)')+';">'+(t!==undefined?formatTime(t):'--')+'</span></div>';
    });
    document.getElementById('perWordTimes').innerHTML=ph;
  }else{document.getElementById('timeStats').classList.add('hidden');}
  const wi=dictItems.filter((_,i)=>checkResults[i]!==true);
  if(wi.length){document.getElementById('resultWrong').classList.remove('hidden');
    document.getElementById('wrongList').innerHTML=wi.map(w=>'<div style="padding:10px;background:#FEF2F2;border-radius:8px;margin-bottom:8px;color:var(--danger);font-weight:500;">❌ '+escapeHtml(w)+'</div>').join('');}
  else document.getElementById('resultWrong').classList.add('hidden');
  records.push({date:new Date().toLocaleString('zh-HK',{month:'numeric',day:'numeric',hour:'2-digit',minute:'2-digit'}),project:currentProject.name,correct,total,percent,totalTime:isManual?totalDictationSeconds:null});
  saveRecords();
}
function retryWrong(){
  const wi=dictItems.filter((_,i)=>checkResults[i]!==true);
  if(!wi.length){alert('冇錯題！');return;}
  originalItems=wi;dictItems=isRandomized?shuffleArray([...originalItems]):[...originalItems];
  currentDictIndex=0;isReviewMode=false;checkResults=new Array(dictItems.length).fill(null);
  totalStartTime=Date.now();wordTimes=[];totalDictationSeconds=0;
  showPage('dictation');updateReviewUI();updateSlimTimerVisibility();showDictItem();
}
function renderHome(){
  const qp=document.getElementById('quickProjects');
  qp.innerHTML=projects.length?projects.slice(0,3).map(p=>'<div class="project-item" onclick="openProject('+p.id+')" style="margin-bottom:8px;"><div class="project-info"><h3>'+escapeHtml(p.name)+'</h3><p>'+langBadge(p)+sampleBadge(p)+'<span>'+p.contents.length+' 項內容</span></p></div><button class="btn btn-success btn-sm" onclick="event.stopPropagation();openProject('+p.id+');startDictation()">▶️</button></div>').join('')
  :'<p style="color:var(--text-light);text-align:center;padding:20px;">暫時未有項目</p>';
  const rs=document.getElementById('recentScores');
  rs.innerHTML=records.length?records.slice(-5).reverse().map(r=>'<div style="display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--border);"><span style="font-weight:500;">'+escapeHtml(r.project)+'</span><span style="font-weight:700;color:'+(r.percent>=70?'var(--success)':'var(--danger)')+';">'+r.percent+'%</span></div>').join('')
  :'<p style="color:var(--text-light);text-align:center;padding:20px;">暫時未有記錄</p>';
}
function renderRecords(){
  const c=document.getElementById('recordChart'),ctx=c.getContext('2d');
  ctx.clearRect(0,0,c.width,c.height);ctx.fillStyle='#F8FAFC';ctx.fillRect(0,0,c.width,c.height);
  ctx.strokeStyle='#E2E8F0';ctx.lineWidth=1;
  for(let i=0;i<=10;i++){const y=20+i*24;ctx.beginPath();ctx.moveTo(40,y);ctx.lineTo(c.width-10,y);ctx.stroke();ctx.fillStyle='#94A3B8';ctx.font='11px sans-serif';ctx.fillText((100-i*10)+'',10,y+4);}
  if(!records.length){ctx.fillStyle='#94A3B8';ctx.font='14px sans-serif';ctx.fillText('暫時未有記錄',c.width/2-40,c.height/2);}
  else{const rec=records.slice(-20),step=(c.width-60)/Math.max(rec.length-1,1);ctx.strokeStyle='#2563EB';ctx.lineWidth=3;ctx.beginPath();rec.forEach((r,i)=>{const x=40+i*step,y=260-(r.percent*2.4);if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y);});ctx.stroke();rec.forEach((r,i)=>{const x=40+i*step,y=260-(r.percent*2.4);ctx.fillStyle=r.percent>=70?'#10B981':'#EF4444';ctx.beginPath();ctx.arc(x,y,5,0,Math.PI*2);ctx.fill();});}
  let html='<table style="width:100%;border-collapse:collapse;font-size:14px;margin-top:16px;"><tr style="background:#F1F5F9;"><th style="padding:12px;text-align:left;">日期</th><th style="text-align:left;">項目</th><th>成績</th><th>得分</th><th>用時</th></tr>';
  records.slice().reverse().slice(0,15).forEach(r=>{
    const tt=(r.totalTime!==null&&r.totalTime!==undefined)?formatTime(r.totalTime):'--';
    html+='<tr style="border-bottom:1px solid var(--border);"><td style="padding:12px;">'+r.date+'</td><td>'+escapeHtml(r.project)+'</td><td style="text-align:center;">'+r.correct+'/'+r.total+'</td><td style="text-align:center;font-weight:700;color:'+(r.percent>=70?'var(--success)':'var(--danger)')+';">'+r.percent+'%</td><td style="text-align:center;color:var(--text-light);">'+tt+'</td></tr>';});
  html+='</table>';document.getElementById('recordTable').innerHTML=html;
}
function clearAllRecords(){if(confirm('確定清除所有記錄？')){records=[];saveRecords();renderRecords();}}
function shuffleArray(a){for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}

window.onload=()=>{
  seedSampleProject();
  loadOpenCC();
  window.speechSynthesis.onvoiceschanged=()=>window.speechSynthesis.getVoices();
  renderHome();
};
</script>

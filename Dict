  document.getElementById('vpLabel').innerText=isReviewMode?'溫習':'進度';
  fill.style.height=(total>1?(current/(total-1))*100:100)+'%';
  track.querySelectorAll('.vp-dot').forEach(d=>d.remove());
  const maxDots=Math.min(total,30);
  for(let i=0;i<maxDots;i++){
    const dot=document.createElement('div');dot.className='vp-dot';

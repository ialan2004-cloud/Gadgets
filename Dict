<!DOCTYPE html>
<html lang="zh-HK">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>中文／英文默書系統 14.1</title>
<script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>
<style>
  :root{--primary:#2563EB;--primary-light:#EFF6FF;--primary-dark:#1D4ED8;--success:#10B981;--danger:#EF4444;--warning:#F59E0B;--bg:#F8FAFC;--card:#fff;--text:#0F172A;--text-light:#64748B;--border:#E2E8F0;--radius:12px;--shadow:0 4px 6px -1px rgba(0,0,0,.05),0 2px 4px -1px rgba(0,0,0,.03);}
  *{box-sizing:border-box;margin:0;padding:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Microsoft JhengHei","PingFang HK",sans-serif;}
  body{background:var(--bg);min-height:100vh;color:var(--text);}
  .navbar{background:#fff;border-bottom:1px solid var(--border);padding:14px 24px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100;}
  .navbar h1{font-size:18px;font-weight:700;color:var(--primary);display:flex;align-items:center;gap:8px;}
  .nav-links{display:flex;gap:6px;}
  .nav-btn{background:transparent;border:none;color:var(--text-light);padding:8px 16px;border-radius:8px;cursor:pointer;font-size:14px;font-weight:500;transition:.2s;}
  .nav-btn:hover{background:var(--primary-light);color:var(--primary);}
  .nav-btn.active{background:var(--primary);color:#fff;}
  .container{max-width:900px;margin:0 auto;padding:24px;}
  .card{background:var(--card);border-radius:var(--radius);padding:24px;margin-bottom:20px;box-shadow:var(--shadow);border:1px solid var(--border);}
  .card-title{font-size:16px;font-weight:600;margin-bottom:16px;display:flex;align-items:center;gap:8px;}
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:10px 20px;border:none;border-radius:8px;font-size:14px;font-weight:500;cursor:pointer;transition:all .2s;}
  .btn:active{transform:scale(.97);}
  .btn-primary{background:var(--primary);color:#fff;}.btn-primary:hover{background:var(--primary-dark);}
  .btn-success{background:var(--success);color:#fff;}
  .btn-danger{background:var(--danger);color:#fff;}
  .btn-outline{background:#fff;border:1px solid var(--border);color:var(--text);}
  .btn-outline:hover{border-color:var(--primary);color:var(--primary);}
  .btn-sm{padding:6px 12px;font-size:13px;}.btn-lg{padding:14px 28px;font-size:16px;}
  .btn-block{width:100%;}.btn-icon{width:36px;height:36px;padding:0;border-radius:8px;font-size:14px;}
  .btn:disabled{opacity:.5;cursor:not-allowed;transform:none;}
  .form-group{margin-bottom:16px;}
  .form-label{display:block;font-size:13px;font-weight:600;margin-bottom:6px;color:var(--text-light);text-transform:uppercase;letter-spacing:.5px;}
  .form-input,.form-select,.form-textarea{width:100%;padding:12px 14px;border:1px solid var(--border);border-radius:8px;font-size:15px;transition:.2s;background:#fff;}
  .form-input:focus,.form-select:focus,.form-textarea:focus{border-color:var(--primary);outline:none;box-shadow:0 0 0 3px rgba(37,99,235,.1);}
  .form-textarea{min-height:120px;resize:vertical;line-height:1.6;}
  .edit-input{padding:8px 12px;font-size:15px;flex:1;min-width:0;}
  .badge{display:inline-flex;align-items:center;padding:4px 10px;border-radius:20px;font-size:12px;font-weight:600;}
  .badge-blue{background:#DBEAFE;color:#1E40AF;}.badge-green{background:#D1FAE5;color:#065F46;}
  .badge-orange{background:#FEF3C7;color:#92400E;}.badge-purple{background:#EDE9FE;color:#5B21B6;}
  .badge-lang-zh{background:#FEF3C7;color:#92400E;}.badge-lang-en{background:#E0E7FF;color:#3730A3;}
  .project-item{display:flex;align-items:center;justify-content:space-between;padding:16px;border:1px solid var(--border);border-radius:10px;margin-bottom:10px;transition:.2s;cursor:pointer;background:#fff;}
  .project-item:hover{border-color:var(--primary);box-shadow:0 4px 12px rgba(37,99,235,.08);}
  .project-info h3{font-size:15px;margin-bottom:4px;}
  .project-info p{font-size:13px;color:var(--text-light);display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
  .content-item{display:flex;align-items:center;padding:12px 14px;background:#F8FAFC;border:1px solid var(--border);border-radius:8px;margin-bottom:8px;gap:10px;transition:.2s;}
  .content-item.editing{background:#EFF6FF;border-color:var(--primary);}
  .content-item .num{width:28px;height:28px;background:var(--primary);color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;flex-shrink:0;}
  .content-item .text{flex:1;font-size:15px;line-height:1.5;min-width:0;word-break:break-word;}
  .content-item .actions{display:flex;gap:4px;flex-shrink:0;align-items:center;}
  .segmented-control{display:inline-flex;background:#F1F5F9;border-radius:8px;padding:4px;gap:4px;flex-wrap:wrap;}
  .seg-btn{padding:8px 14px;border:none;background:transparent;border-radius:6px;font-size:13px;font-weight:500;color:var(--text-light);cursor:pointer;transition:all .2s;white-space:nowrap;}
  .seg-btn.active{background:#fff;color:var(--primary);box-shadow:0 1px 3px rgba(0,0,0,.1);font-weight:600;}
  .seg-btn:hover:not(.active){color:var(--text);}
  .dictation-layout{display:flex;gap:20px;align-items:stretch;}
  .dictation-main{flex:1;min-width:0;}
  .dictation-sidebar{width:56px;flex-shrink:0;display:flex;flex-direction:column;align-items:center;}
  .vp-container{position:relative;flex:1;width:100%;display:flex;flex-direction:column;align-items:center;}
  .vp-label{font-size:11px;font-weight:700;color:var(--text-light);margin-bottom:8px;text-align:center;white-space:nowrap;}
  .vp-track{position:relative;width:6px;flex:1;background:#E2E8F0;border-radius:3px;min-height:200px;}
  .vp-fill{position:absolute;top:0;left:0;width:100%;background:linear-gradient(180deg,var(--primary),#60A5FA);border-radius:3px;transition:height .4s ease;}
  .vp-dot{position:absolute;left:50%;transform:translateX(-50%);width:16px;height:16px;border-radius:50%;border:2px solid #CBD5E1;background:#fff;transition:all .3s;z-index:2;}
  .vp-dot.completed{border-color:var(--success);background:var(--success);}
  .vp-dot.current{border-color:var(--primary);background:var(--primary);box-shadow:0 0 0 4px rgba(37,99,235,.2);animation:vpPulse 1.5s infinite;}
  .vp-dot.upcoming{border-color:#CBD5E1;background:#fff;}
  @keyframes vpPulse{0%,100%{box-shadow:0 0 0 4px rgba(37,99,235,.2)}50%{box-shadow:0 0 0 8px rgba(37,99,235,.1)}}
  .vp-count{font-size:12px;font-weight:700;color:var(--primary);margin-top:8px;}
  .dictation-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;}
  .dictation-display{background:linear-gradient(135deg,#F8FAFC 0%,#EFF6FF 100%);border:2px dashed var(--border);border-radius:16px;padding:36px 20px;text-align:center;margin:20px 0 8px 0;min-height:140px;display:flex;align-items:center;justify-content:center;position:relative;}
  .dictation-text{font-size:34px;font-weight:700;line-height:1.5;letter-spacing:2px;transition:filter .3s;}
  .dictation-text.hidden-text{filter:blur(12px);user-select:none;color:var(--text-light);}
  .review-banner{position:absolute;top:10px;left:50%;transform:translateX(-50%);background:var(--warning);color:#fff;padding:4px 14px;border-radius:20px;font-size:12px;font-weight:600;}
  .manual-timer-wrap{display:none;justify-content:center;gap:12px;margin:0 0 12px 0;flex-wrap:wrap;}
  .manual-timer-wrap.visible{display:flex;}
  .mt-chip{background:#F1F5F9;border-radius:20px;padding:6px 16px;font-size:13px;color:var(--text-light);}
  .mt-chip strong{color:var(--text);font-variant-numeric:tabular-nums;margin-left:2px;}
  .time-chip{background:#F1F5F9;border-radius:12px;padding:3px 10px;font-size:12px;color:var(--text-light);margin-right:10px;white-space:nowrap;font-variant-numeric:tabular-nums;}
  .slim-timer-wrap{margin:0 0 12px 0;display:none;align-items:center;gap:10px;}
  .slim-timer-wrap.visible{display:flex;}
  .slim-timer-track{flex:1;height:6px;background:#E2E8F0;border-radius:3px;overflow:hidden;}
  .slim-timer-fill{height:100%;border-radius:3px;transition:width 1s linear,background .5s;background:var(--primary);}
  .slim-timer-fill.safe{background:#10B981;}.slim-timer-fill.warning{background:#F59E0B;}.slim-timer-fill.danger{background:#EF4444;}
  .slim-timer-text{font-size:12px;font-weight:700;color:var(--text-light);min-width:32px;text-align:right;}
  .slim-timer-status{font-size:11px;color:var(--text-light);min-width:60px;}
  .settings-row{display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border);flex-wrap:wrap;gap:10px;}
  .settings-row:last-child{border-bottom:none;}
  .settings-label{font-size:14px;font-weight:500;display:flex;align-items:center;gap:6px;}
  .toggle{position:relative;display:inline-block;width:44px;height:24px;}
  .toggle input{opacity:0;width:0;height:0;}
  .toggle-slider{position:absolute;cursor:pointer;top:0;left:0;right:0;bottom:0;background:#CBD5E1;border-radius:24px;transition:.3s;}
  .toggle-slider:before{position:absolute;content:"";height:18px;width:18px;left:3px;bottom:3px;background:#fff;border-radius:50%;transition:.3s;box-shadow:0 1px 3px rgba(0,0,0,.2);}
  input:checked+.toggle-slider{background:var(--primary);}
  input:checked+.toggle-slider:before{transform:translateX(20px);}
  .countdown-ring{width:56px;height:56px;border-radius:50%;background:conic-gradient(var(--primary) 0%,#E2E8F0 0%);display:flex;align-items:center;justify-content:center;margin:8px auto;}
  .countdown-inner{width:46px;height:46px;background:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:700;color:var(--primary);}
  .check-item{display:flex;align-items:center;padding:16px;border:1px solid var(--border);border-radius:10px;margin-bottom:10px;transition:.2s;background:#fff;}
  .check-item.correct{border-color:var(--success);background:#F0FDF4;}
  .check-item.wrong{border-color:var(--danger);background:#FEF2F2;}
  .check-item .answer{flex:1;font-size:16px;font-weight:500;}
  .check-btns{display:flex;gap:10px;}
  .check-btn{width:44px;height:44px;border-radius:50%;border:2px solid var(--border);background:#fff;font-size:20px;cursor:pointer;transition:.2s;display:flex;align-items:center;justify-content:center;}
  .check-btn:hover{transform:scale(1.1);}
  .check-btn.btn-correct.active{background:var(--success);border-color:var(--success);color:#fff;}
  .check-btn.btn-wrong.active{background:var(--danger);border-color:var(--danger);color:#fff;}
  .stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:20px 0;}
  .stat-box{text-align:center;padding:20px;background:#F8FAFC;border-radius:12px;border:1px solid var(--border);}
  .stat-box .value{font-size:32px;font-weight:800;color:var(--primary);}
  .stat-box .label{font-size:13px;color:var(--text-light);margin-top:4px;font-weight:500;}
  .scan-area{border:2px dashed #CBD5E1;border-radius:12px;padding:40px;text-align:center;cursor:pointer;transition:.2s;background:#F8FAFC;}
  .scan-area:hover{border-color:var(--primary);background:var(--primary-light);}
  .scan-area .icon{font-size:40px;margin-bottom:12px;}
  .scan-preview{max-width:100%;max-height:200px;border-radius:8px;margin:12px 0;object-fit:contain;border:1px solid var(--border);}
  .ocr-progress .bar{height:6px;background:#E2E8F0;border-radius:3px;overflow:hidden;}
  .ocr-progress .fill{height:100%;background:var(--primary);transition:width .3s;}
  .ocr-item{display:flex;align-items:center;gap:8px;padding:10px 12px;background:#F8FAFC;border:1px solid var(--border);border-radius:8px;margin-bottom:6px;font-size:14px;}
  .ocr-item.editing{background:#EFF6FF;border-color:var(--primary);}
  .ocr-item .oi-num{width:24px;height:24px;background:var(--primary);color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex-shrink:0;}
  .ocr-item .oi-text{flex:1;line-height:1.4;min-width:0;word-break:break-word;}
  .ocr-item .oi-actions{display:flex;gap:4px;flex-shrink:0;align-items:center;}
  .ocr-detect-info{background:#EFF6FF;border:1px solid #BFDBFE;border-radius:8px;padding:10px 14px;font-size:13px;color:#1E40AF;margin-bottom:12px;display:flex;align-items:center;gap:8px;}
  .start-settings{background:#F8FAFC;border:1px solid var(--border);border-radius:10px;padding:16px;margin-top:16px;}
  .start-settings .ss-row{display:flex;align-items:center;justify-content:space-between;padding:8px 0;}
  .start-settings .ss-label{font-size:14px;font-weight:500;display:flex;align-items:center;gap:8px;}
  .sample-note{background:#F5F3FF;border:1px solid #DDD6FE;border-radius:8px;padding:10px 14px;font-size:13px;color:#5B21B6;margin-bottom:12px;}
  .sync-section{border:1px solid var(--border);border-radius:12px;padding:20px;margin-bottom:16px;background:#fff;}
  .sync-section h3{font-size:15px;margin-bottom:8px;display:flex;align-items:center;gap:8px;}
  .sync-section p{font-size:13px;color:var(--text-light);margin-bottom:14px;line-height:1.5;}
  .sync-status{margin-top:12px;padding:10px 14px;border-radius:8px;font-size:14px;display:none;}
  .sync-status.show{display:block;}
  .sync-status.success{background:#F0FDF4;color:#065F46;border:1px solid #A7F3D0;}
  .sync-status.error{background:#FEF2F2;color:#991B1B;border:1px solid #FECACA;}
  .sync-status.loading{background:#EFF6FF;color:#1E40AF;border:1px solid #BFDBFE;}
  .sheet-format-box{background:#F8FAFC;border:1px solid var(--border);padding:14px;border-radius:8px;margin:10px 0;font-family:monospace;font-size:12px;line-height:1.6;color:var(--text);}
  .sheet-id-box{background:#F1F5F9;border:1px solid var(--border);border-radius:8px;padding:12px;margin-bottom:14px;}
  .debug-box{font-size:11px;background:#0F172A;color:#94A3B8;padding:12px;border-radius:8px;white-space:pre-wrap;word-break:break-all;max-height:220px;overflow-y:auto;font-family:monospace;margin-top:10px;}
  details summary{cursor:pointer;color:var(--primary);font-size:14px;font-weight:500;}
  .last-sync-info{font-size:12px;color:var(--text-light);background:#F1F5F9;padding:6px 12px;border-radius:16px;display:inline-block;margin-bottom:12px;}
  .modal{display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(15,23,42,.6);backdrop-filter:blur(4px);z-index:1000;align-items:center;justify-content:center;padding:20px;}
  .modal.show{display:flex;}
  .modal-content{background:#fff;border-radius:16px;padding:28px;max-width:560px;width:100%;max-height:85vh;overflow-y:auto;box-shadow:0 20px 25px -5px rgba(0,0,0,.1);animation:slideUp .3s ease;position:relative;}
  @keyframes slideUp{from{transform:translateY(20px);opacity:0}to{transform:translateY(0);opacity:1}}
  .modal-title{font-size:18px;font-weight:700;margin-bottom:20px;display:flex;align-items:center;gap:8px;padding-right:36px;}
  .modal-close{position:absolute;top:16px;right:16px;width:32px;height:32px;border-radius:50%;background:#F1F5F9;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:16px;color:#64748B;transition:.2s;z-index:10;}
  .modal-close:hover{background:#E2E8F0;color:#0F172A;transform:rotate(90deg);}
  .review-options{display:flex;gap:12px;margin-top:20px;}
  .review-option{flex:1;padding:20px;border:2px solid var(--border);border-radius:12px;text-align:center;cursor:pointer;transition:.2s;background:#fff;}
  .review-option:hover{border-color:var(--primary);background:var(--primary-light);}
  .review-option .ro-icon{font-size:32px;margin-bottom:8px;}
  .review-option .ro-title{font-weight:600;font-size:15px;margin-bottom:4px;}
  .review-option .ro-desc{font-size:12px;color:var(--text-light);}
  .hidden{display:none!important;}.text-center{text-align:center;}
  .mt-2{margin-top:16px;}.mt-3{margin-top:24px;}.mb-2{margin-bottom:16px;}
  .flex-between{display:flex;justify-content:space-between;align-items:center;}
  .list-toolbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;flex-wrap:wrap;gap:8px;}
  .hint{font-size:12px;color:var(--text-light);}
  @media(max-width:640px){
    .navbar{padding:12px 16px;flex-wrap:wrap;gap:8px;}.navbar h1{font-size:16px;}
    .nav-btn{padding:6px 10px;font-size:12px;}
    .container{padding:12px;}.card{padding:16px;}
    .stats-grid{grid-template-columns:1fr;}
    .segmented-control{width:100%;}.seg-btn{flex:1;text-align:center;padding:8px 6px;font-size:12px;}
    .dictation-text{font-size:26px;}
    .settings-row{flex-direction:column;align-items:flex-start;}
    .dictation-layout{flex-direction:column;}
    .dictation-sidebar{width:100%;flex-direction:row;justify-content:center;}
    .vp-track{min-height:auto;width:auto;height:6px;flex:1;}
    .vp-container{flex-direction:row;width:100%;}
    .vp-label{margin-bottom:0;margin-right:8px;}.vp-count{margin-top:0;margin-left:8px;}
    .vp-dot{top:50%!important;transform:translateY(-50%);left:auto!important;}
    .vp-fill{height:100%!important;width:auto;transition:width .4s ease;}
    .review-options{flex-direction:column;}
    .content-item{flex-wrap:wrap;}
    .content-item .actions{width:100%;justify-content:flex-end;margin-top:6px;}
  }
</style>
</head>
<body>

<nav class="navbar">
  <h1>📋 中文／英文默書系統</h1>
  <div class="nav-links">
    <button class="nav-btn active" onclick="showPage('home')">🏠 主頁</button>
    <button class="nav-btn" onclick="showPage('projects')">📁 項目</button>
    <button class="nav-btn" onclick="showPage('records')">📊 記錄</button>
    <button class="nav-btn" onclick="showPage('sync')">☁️ 同步</button>
  </div>
</nav>

<div class="container">
  <div id="page-home">
    <div class="card"><div class="card-title">🚀 快速開始</div>
      <p style="color:var(--text-light);margin-bottom:16px;font-size:14px;">選擇一個默書項目開始溫習</p>
      <div id="quickProjects"></div>
      <button class="btn btn-primary btn-block mt-2" onclick="showPage('projects')">📁 管理所有項目</button></div>
    <div class="card"><div class="card-title">📊 最近成績</div><div id="recentScores"></div></div>
  </div>

  <div id="page-projects" class="hidden">
    <div class="card"><div class="flex-between">
      <div class="card-title" style="margin-bottom:0;">📁 默書項目</div>
      <button class="btn btn-primary" onclick="showModal('modalNewProject')">➕ 新建項目</button></div></div>
    <div id="projectList"></div>
  </div>

  <div id="page-project-detail" class="hidden">
    <div class="card"><div class="flex-between">
      <div><h2 id="detailTitle" style="font-size:20px;margin-bottom:6px;"></h2><span id="detailBadge"></span></div>
      <button class="btn btn-outline" onclick="showPage('projects')">⬅️ 返回</button></div></div>
    <div class="card">
      <div id="sampleNote" class="sample-note hidden">🎁 呢個係系統預設嘅示例項目，可以隨意編輯或刪除。</div>
      <div class="list-toolbar">
        <div class="card-title" style="margin-bottom:0;">📝 默書內容 (<span id="contentCount">0</span>)</div>
        <div style="display:flex;gap:8px;">
          <button class="btn btn-primary btn-sm" onclick="showModal('modalAddContent')">✍️ 手動加入</button>
          <button class="btn btn-outline btn-sm" onclick="openScanModal()">📷 掃描</button></div></div>
      <div class="hint" style="margin-bottom:12px;">💡 ✏️ 編輯 ⬆️⬇️ 排序 ✖ 刪除</div>
      <div id="contentList"></div>
      <div class="start-settings">
        <div class="ss-row"><div class="ss-label">🔀 隨機打亂</div>
          <label class="toggle"><input type="checkbox" id="preRandomToggle"><span class="toggle-slider"></span></label></div>
        <div class="ss-row"><div class="ss-label">🔊 朗讀速度</div>
          <div class="segmented-control" id="preSpeedControl">
            <button class="seg-btn" onclick="setPreSpeed(0.4,this)">0.4x</button>
            <button class="seg-btn" onclick="setPreSpeed(0.6,this)">0.6x</button>
            <button class="seg-btn active" onclick="setPreSpeed(0.8,this)">0.8x</button>
            <button class="seg-btn" onclick="setPreSpeed(1.0,this)">1.0x</button></div></div>
        <div class="ss-row"><div class="ss-label">⏱️ 播放模式</div>
          <div class="segmented-control" id="preModeControl">
            <button class="seg-btn active" data-mode="manual" onclick="setPreMode('manual',this)">✋ 手動</button>
            <button class="seg-btn" data-mode="auto" onclick="setPreMode('auto',this)">🤖 自動</button></div></div>
        <div class="ss-row hidden" id="preAutoRow"><div class="ss-label">⏳ 間隔</div>
          <div class="segmented-control" id="preIntervalControl">
            <button class="seg-btn" onclick="setPreInterval(5,this)">5秒</button>
            <button class="seg-btn active" onclick="setPreInterval(7,this)">7秒</button>
            <button class="seg-btn" onclick="setPreInterval(10,this)">10秒</button>

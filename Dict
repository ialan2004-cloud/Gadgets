function parseCSV(text){
  if(text.charCodeAt(0)===0xFEFF)text=text.slice(1);
  const rows=[];let row=[];let field='';let inQ=false;
  for(let i=0;i<text.length;i++){
    const c=text[i];
    if(inQ){
      if(c==='"'){if(text[i+1]==='"'){field+='"';i++;}else inQ=false;}
      else field+=c;
    }else{
      if(c==='"')inQ=true;
      else if(c===','){row.push(field);field='';}
      else if(c==='\n'){row.push(field);rows.push(row);row=[];field='';}
      else if(c==='\r'){}
      else field+=c;
    }
  }
  if(field!==''||row.length>0){row.push(field);rows.push(row);}
  // remove completely empty rows
  return rows.filter(r=>r.some(cell=>(cell||'').trim()!==''));
}
function parseDetails(details){
  return details.split(/[;；]/).map(s=>s.trim()).filter(s=>s.length>0);
}
function generateIdFromName(name,lang){
  const str=name+'_'+lang;let h=0;
  for(let i=0;i<str.length;i++){h=((h<<5)-h)+str.charCodeAt(i);h|=0;}
  return 'sheet_'+Math.abs(h);
}
function normalizeType(t){
  t=(t||'').toLowerCase();
  if(t.includes('句')||t.includes('sentence'))return 'sentences';
  if(t.includes('文章')||t.includes('passage')||t.includes('段')||t.includes('paragraph'))return 'passage';
  return 'words';
}
function parseSheetCSV(csvText,lang){
  const rows=parseCSV(csvText);
  if(!rows.length)return [];
  let projIdx=0,typeIdx=1,detailIdx=2,startIdx=0;
  const header=rows[0].map(c=>(c||'').trim().toLowerCase());
  const hasHeader=header.some(h=>h.includes('project')||h.includes('type')||h.includes('detail')||h.includes('項目')||h.includes('類型')||h.includes('內容'));
  if(hasHeader){
    startIdx=1;
    const pi=header.findIndex(h=>h.includes('project')||h.includes('項目')||h.includes('名稱'));
    const ti=header.findIndex(h=>h.includes('type')||h.includes('類型'));
    const di=header.findIndex(h=>h.includes('detail')||h.includes('內容'));
    if(pi>=0)projIdx=pi;
    if(ti>=0)typeIdx=ti;
    if(di>=0)detailIdx=di;
  }
  debugLog('['+lang+'] 偵測到標題行：'+(hasHeader?'係':'否')+'；欄位 Project='+projIdx+' Type='+typeIdx+' Details='+detailIdx);
  const projectMap={};
  for(let i=startIdx;i<rows.length;i++){
    const r=rows[i];
    const name=(r[projIdx]||'').trim();
    const type=(r[typeIdx]||'').trim();
    const details=(r[detailIdx]||'').trim();
    if(!name||!details)continue;
    const items=parseDetails(details);
    if(!items.length)continue;
    if(!projectMap[name]){
      projectMap[name]={id:generateIdFromName(name,lang),name:name,type:normalizeType(type),lang:lang,contents:[],fromSheet:true,createdAt:new Date().toLocaleDateString('zh-HK')};
    }
    items.forEach(item=>{if(!projectMap[name].contents.includes(item))projectMap[name].contents.push(item);});
  }
  return Object.values(projectMap);
}
// Sheet = source of truth: re-sync REPLACES contents of matching projects
function mergeSheetProjects(sheetProjects){
  let added=0,updated=0;
  sheetProjects.forEach(sp=>{
    const idx=projects.findIndex(p=>p.id===sp.id||(p.name===sp.name&&p.lang===sp.lang));
    if(idx>=0){
      projects[idx].contents=[...sp.contents];
      projects[idx].type=sp.type;
      projects[idx].fromSheet=true;
      updated++;
    }else{
      projects.push(sp);
      added++;
    }
  });
  return {added,updated};
}

// ================= LANGUAGE-AWARE SPEECH =================
function speakText(text,lang,onDone){
  if('speechSynthesis' in window){
    window.speechSynthesis.cancel();
    const u=new SpeechSynthesisUtterance(text);
    if(lang==='en'){
      u.lang='en-US';
      const v=window.speechSynthesis.getVoices().find(x=>x.lang&&x.lang.startsWith('en'));
      if(v)u.voice=v;
    }else{
      u.lang='zh-HK';
      const v=window.speechSynthesis.getVoices().find(x=>x.lang&&x.lang.startsWith('zh'));
      if(v)u.voice=v;
    }
    u.rate=speechRate;
    if(onDone){u.onend=onDone;u.onerror=onDone;}
    window.speechSynthesis.speak(u);
    return true;
  }
  if(onDone)onDone();
  return false;
}
